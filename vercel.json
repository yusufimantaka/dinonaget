{
    "version": 2,
    "projects": [
      {
        "name": "frontend",
        "root": "stecu-frontend",
        "buildCommand": "npm --prefix stecu-frontend run build",
        "outputDirectory": "stecu-frontend/build"
      },
      {
        "name": "backend",
        "root": "stecu-backend",
        "builds": [
          { "src": "stecu-backend/api/*.js", "use": "@vercel/node" }
        ],
        "routes": [
          { "src": "/api/(.*)", "dest": "stecu-backend/api/$1.js" }
        ]
      }
    ]
  }
  